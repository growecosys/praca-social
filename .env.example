# Neon (pooled for the app, direct for migrations/imports)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (private store)
BLOB_READ_WRITE_TOKEN=

# Optional features
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_ORIGIN=https://praca.social

# Only for scripts/transfer-r2-to-blob.mjs (one-off migration, never deployed)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
